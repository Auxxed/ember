[Unit]
Description=Ember Peak Pro BLE daemon
After=bluetooth.target

[Service]
Type=simple
ExecStart=%h/.local/share/ember/venv/bin/python -m ember.daemon
Environment=PYTHONPATH=%h/.local/share/ember/src
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

[Install]
WantedBy=default.target
