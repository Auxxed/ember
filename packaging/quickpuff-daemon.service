[Unit]
Description=QuickPuff Peak Pro BLE daemon
After=bluetooth.target

[Service]
Type=simple
ExecStart=%h/.local/share/quickpuff/venv/bin/python -m quickpuff.daemon
Environment=PYTHONPATH=%h/.local/share/quickpuff/src
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

[Install]
WantedBy=default.target
