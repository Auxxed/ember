[Unit]
Description=OmaPuffco Peak Pro BLE daemon
After=bluetooth.target

[Service]
Type=simple
ExecStart=%h/.local/share/omapuffco/venv/bin/python -m omapuffco.daemon
Environment=PYTHONPATH=%h/.local/share/omapuffco/src
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

[Install]
WantedBy=default.target
